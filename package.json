{
  "name": "trellis-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Trellis — AI-Powered Celebration & Event Planning Platform",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @trellis/api --filter @trellis/web run dev",
    "build": "pnpm --filter \"@trellis/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter \"@trellis/*\" run typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.13.0",
    "supertest": "^7.3.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.0.7"
  }
}
