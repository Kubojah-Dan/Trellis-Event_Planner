# ==============================================================================
# Trellis Environment Configuration Template
# DO NOT commit real secrets or production credentials to source control.
# Copy this file to .env.local (in apps/web or apps/api as appropriate) for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# API Service Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Firebase Server Configuration
FIREBASE_PROJECT_ID=trellis-dev-placeholder
# Set to 'true' to use the local Firebase Emulator Suite
USE_FIREBASE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# GenAI / Gemini Provider Configuration
# Obtain an API key from Google AI Studio (https://aistudio.google.com/) for local development
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_PLACEHOLDER
# Default model identifier for Genkit / Gemini provider
GEMINI_MODEL=gemini-2.5-flash

# Optional External Providers (Disabled if not configured)
# GOOGLE_PLACES_API_KEY=YOUR_PLACES_KEY_PLACEHOLDER
# UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_ACCESS_KEY_PLACEHOLDER

# ------------------------------------------------------------------------------
# Web Frontend Configuration (apps/web - VITE_ prefixed for client bundle)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_USE_FIREBASE_EMULATOR=true

# Firebase Public Web Configuration (Identifiers, not admin secrets)
VITE_FIREBASE_API_KEY=AIzaSy_PLACEHOLDER_PUBLIC_WEB_KEY
VITE_FIREBASE_AUTH_DOMAIN=trellis-dev-placeholder.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=trellis-dev-placeholder
VITE_FIREBASE_STORAGE_BUCKET=trellis-dev-placeholder.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000
